# ==============================================================
# CONFIGURAZIONE AMBIENTE - SERRA BADEN-POWELL SAVONA
# Copia questo file in .env e compila con le tue credenziali reali
# ==============================================================

# Database MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/serra_savona?retryWrites=true&w=majority

# Autenticazione & JWT
JWT_SECRET=super_segreto_jwt_serra_savona_2026_chiave_complessa
PORT=5000
NODE_ENV=production
BASE_URL=https://tuo-dominio-serra.vercel.app

# Email & SMTP (Nodemailer)
# Mittente predefinito: business.matty47ghigo@gmail.com
EMAIL_FROM=business.matty47ghigo@gmail.com
INTERNAL_NOTIFICATION_EMAIL=business.matty47ghigo@gmail.com

# Opzione A: SMTP Dedicato
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=business.matty47ghigo@gmail.com
SMTP_PASS=tuapasswordappgmail

# Opzione B: Gmail App Password
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google OAuth Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Anti-Bot Security (Cloudflare Turnstile o Google reCAPTCHA)
TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxx
CAPTCHA_SECRET_KEY=

# Vercel Cron Job Secret (per proteggere l'invio promemoria a 48h)
CRON_SECRET=chiave_segreta_per_invocazione_cron_serra_2026
